# ─────────────────────────────────────────────────────────────
# SERRU LAB — environment configuration
# Copy to .env.local (development) or set on your server (production).
# ─────────────────────────────────────────────────────────────

# Public URLs. The admin panel is served ONLY on ADMIN_URL's host.
# Development: http://localhost:3000 and http://admin.localhost:3000
# Production:  https://serrulab.com  and https://admin.serrulab.com
STORE_URL=http://localhost:3000
ADMIN_URL=http://admin.localhost:3000

# First admin account — created by `npm run seed` when no admin exists yet.
# Change the password from Admin → Settings → Security after the first login.
ADMIN_EMAIL=admin@serrulab.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# ── Card payments (Visa / Mastercard) via Tap Payments ───────
# Secret key from the API keys section of your Tap dashboard. Start with sk_test_…, switch to sk_live_… to go live.
# Leave empty in development to use the built-in TEST MODE checkout (no real charges).
# Payment updates are posted automatically to {STORE_URL}/api/tap/webhook once the site runs on HTTPS.
TAP_SECRET_KEY=
# Payment source on Tap's hosted page: src_card (Visa/Mastercard, default) or src_all (every method enabled on your account).
TAP_PAYMENT_SOURCE=src_card

# The built-in test card checkout is disabled in production unless this is "true".
# Never enable it on a live store.
PAYMENTS_ALLOW_TEST_MODE=false

# ── Email (optional) ─────────────────────────────────────────
# Without SMTP, emails are written to storage/outbox.log (on Vercel: the runtime logs) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SERRU LAB <hello@serrulab.com>"
# Where new-order and contact-form notifications go.
NOTIFY_EMAIL=

# ── Storage ──────────────────────────────────────────────────
# Development: leave these empty — the database and uploaded images live in DATA_DIR (default: ./storage).
DATA_DIR=
# Production on Vercel: filled in automatically when you connect a Turso database and a Blob store
# to the project (Vercel → Storage). Set them locally only to run `npm run seed` / `create-admin` against production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
